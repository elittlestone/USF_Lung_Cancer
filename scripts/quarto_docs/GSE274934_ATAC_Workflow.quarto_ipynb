      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "---\n",
        "title: \"GSE274934 Lung Cancer ATAC Workflow\"\n",
        "date: today\n",
        "author: \"Ethan Littlestone\"\n",
        "execute:\n",
        "    echo: true\n",
        "    eval: true\n",
        "    dir: /Users/ethanlittlestone/USF_Lung_Cancer\n",
        "format: \n",
        "    html:\n",
        "        theme: cosmo\n",
        "        toc: true\n",
        "        toc-location: left\n",
        "        number-sections: true\n",
        "        code-fold: true\n",
        "        code-tools: true\n",
        "        smooth-scroll: true\n",
        "        highlight-style: github\n",
        "        self-contained: true\n",
        "---\n"
      ],
      "id": "9a8ee57f"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "#| eval: false\n",
        "mkdir ../../data/raw/GSE274934/ATAC\n",
        "\n",
        "# Get SRP for our given GSE (experiment)\n",
        "pysradb gse-to-srp GSE274934\n",
        "\n",
        "# Get metadata and GSM Ids and Sample Ids\n",
        "pysradb metadata SRP526658 | grep 'ATAC-seq' | cut -f 4 | \\\n",
        "awk -F'[:,]' '{gsub(/^ /,\"\",$2); print $1 \",\" $2}' > data/raw/GSE274934/ATAC/GSM_IDS_and_Sample_IDS.txt\n",
        "cat ../../data/raw/GSE274934/ATAC/GSM_IDS_and_Sample_IDS.txt\n",
        "\n",
        "# Output "
      ],
      "id": "bf3d8d43",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "```{python Snakemake script}\n",
        "\n",
        "#| eval: false\n",
        "#| echo: false\n",
        "\n",
        "gsm_ids = config[\"single_cell_ATAC\"][\"gsm_ids\"]\n",
        "sample_ids = config[\"single_cell_ATAC\"][\"sample_ids\"]\n",
        "\n",
        "\n",
        "ATAC_FILES = [\"fragments.tsv.gz\", \"peaks.bed.gz\", \"singlecell.csv.gz\"]\n",
        "\n",
        "\n",
        "def atac_url(gsm, sample, filename):\n",
        "  return f\"https://ftp.ncbi.nlm.nih.gov/geo/samples/{gsm[:7]}nnn/{gsm}/suppl/{gsm}_{sample}_ATAC_{filename}\"\n",
        "\n",
        "\n",
        "def output_path(gsm, sample, filename):\n",
        "    return f\"data/raw/GSE274934/ATAC/{gsm}_{sample}_ATAC_{filename}\"\n",
        "\n",
        "\n",
        "all_files = expand(output_path(gsm = gsm_ids, sample = sample_ids, filename = ATAC_FILES),\n",
        "                   gsm = gsm_ids, sample = sample_ids, filename = ATAC_FILES)\n",
        "\n",
        "\n",
        "rule all:\n",
        "  input:\n",
        "    all_files\n",
        "\n",
        "rule download_atac_files:\n",
        "  output:\n",
        "    path = \"data/raw/GSE274934/ATAC/{gsm}_{sample}_ATAC_{filename}\"\n",
        "  params:\n",
        "    url = lambda wildcards: atac_url(wildcards.gsm, wildcards.sample, wildcards.filename)\n",
        "  shell:\n",
        "    \"\"\"\n",
        "    wget -nc {params.url} -O {output.path}\n",
        "    \"\"\"\n",
        "\n",
        "```\n"
      ],
      "id": "1fa13305"
    },
    {
      "cell_type": "code",
      "metadata": {},
      "source": [
        "snakemake -s scripts/snakemake_scripts/GSE274934_ATAC_workflow.smk -p --cores 8"
      ],
      "id": "83497b6a",
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "```{python}\n",
        "import glob \n",
        "import scvi\n",
        "import scanpy as sc\n",
        "import os\n",
        "import pandas as pd\n",
        "\n",
        "def run_scvi_atac_multi_inmemory(\n",
        "    adata_paths,\n",
        "    output_dir,\n",
        "    min_counts=1000,\n",
        "    min_cells=10,\n",
        "    max_epochs=100,\n",
        "    early_stopping=True,\n",
        "    use_umap=True\n",
        "):\n",
        "    adata_list = []\n",
        "    print(f\"Loading {len(adata_paths)} datasets...\")\n",
        "\n",
        "    for path in adata_paths:\n",
        "        print(f\"Loading {path} ...\")\n",
        "        ad = scvi.data.read_10x_h5(path)\n",
        "        sample_name = os.path.basename(path).split(\"_\")[0]  # extract sample ID\n",
        "        ad.obs[\"sample\"] = sample_name\n",
        "        adata_list.append(ad)\n",
        "\n",
        "    print(\"Concatenating datasets...\")\n",
        "    adata = sc.concat(adata_list, label=\"sample\", index_unique=\"-\")\n",
        "\n",
        "    print(\"Filtering cells and peaks...\")\n",
        "    sc.pp.filter_cells(adata, min_counts=min_counts)\n",
        "    sc.pp.filter_genes(adata, min_cells=min_cells)\n",
        "\n",
        "    print(\"Setting up AnnData for scvi ATAC model...\")\n",
        "    scvi.data.setup_anndata(adata)\n",
        "\n",
        "    print(\"Creating and training SCVI model...\")\n",
        "    model = scvi.model.SCVI(adata)\n",
        "    model.train(max_epochs=max_epochs, early_stopping=early_stopping)\n",
        "\n",
        "    print(\"Getting latent representation...\")\n",
        "    latent = model.get_latent_representation()\n",
        "    adata.obsm[\"X_scVI\"] = latent\n",
        "\n",
        "    os.makedirs(output_dir, exist_ok=True)\n",
        "    adata_file = os.path.join(output_dir, \"adata_scvi_atac_combined.h5ad\")\n",
        "    print(f\"Saving AnnData to {adata_file}...\")\n",
        "    adata.write_h5ad(adata_file)\n",
        "\n",
        "    latent_csv = os.path.join(output_dir, \"scvi_latent_embeddings_combined.csv\")\n",
        "    print(f\"Saving latent embeddings to {latent_csv}...\")\n",
        "    df_latent = pd.DataFrame(latent, index=adata.obs_names)\n",
        "    df_latent.to_csv(latent_csv)\n",
        "\n",
        "    if use_umap:\n",
        "        print(\"Computing UMAP embedding...\")\n",
        "        sc.pp.neighbors(adata, use_rep=\"X_scVI\")\n",
        "        sc.tl.umap(adata)\n",
        "\n",
        "        import matplotlib.pyplot as plt\n",
        "        print(\"Plotting UMAP colored by sample...\")\n",
        "        sc.pl.umap(adata, color=\"sample\", show=True)\n",
        "    \n",
        "    print(\"scVI ATAC workflow completed!\")\n",
        "    return adata, model\n",
        "\n",
        "\n",
        "h5_files_dir = \"data/raw/GSE274934/ATAC\"\n",
        "\n",
        "adata_paths = glob.glob(os.path.join(h5_files_dir, \"*_filtered_peac_bc_matrix.h5\"))\n",
        "\n",
        "output_dir = \"results/GSE274934/ATAC/figures\"\n",
        "\n",
        "adata, model = run_scvi_atac_multi_inmemory(\n",
        "    adata_paths=adata_paths,\n",
        "    output_dir=output_dir,\n",
        "    min_counts=500,\n",
        "    min_cells=5,\n",
        "    max_epochs=100,\n",
        "    early_stopping=True,\n",
        "    use_umap=True\n",
        ")\n",
        "\n",
        "```"
      ],
      "id": "298590db"
    }
  ],
